pkgbase = betterguac
	pkgdesc = Remote access gateway (SSH, RDP, VNC) based on Apache Guacamole, with MFA, YAML sync and an activity log
	pkgver = 1.6.0+bg11
	pkgrel = 1
	url = https://betterguac.org
	install = betterguac.install
	arch = x86_64
	arch = aarch64
	license = Apache-2.0
