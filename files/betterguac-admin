#!/bin/sh
# BetterGuac administration helper. Run as root:
#   sudo betterguac-admin status
#   sudo betterguac-admin reset-password <username>
#   sudo betterguac-admin migrate      (apply database schema changes; --status lists them)
#   sudo betterguac-admin setup        (re-run the install-time setup)
#   sudo betterguac-admin webapp       (rebuild the Tomcat 10 copy of the web application)
exec /usr/lib/betterguac/betterguac-setup "$@"
