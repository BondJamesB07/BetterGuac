#!/bin/bash
# BetterGuac setup helper, used by the package's maintainer scripts and by
# betterguac-admin. Every step checks first and never overwrites settings,
# accounts or data that already exist, so it is safe to run again.
set -euo pipefail
umask 022

CONF=/etc/betterguac
PROPS=$CONF/guacamole.properties
KEYS=$CONF/keys
SYNC_ENV=$CONF/sync.env
ADMIN_FILE=$CONF/initial-admin.txt
SHARE=/usr/share/betterguac
STATE=/var/lib/betterguac
DB_NAME=betterguac
DB_USER=betterguac
SYNC_DB=betterguac_yamlsync
SYNC_USER=betterguac_sync
TOMCAT_GROUP=tomcat
CTXDIR=/etc/tomcat10/Catalina/localhost
# the service that runs the web application: betterguac-web on Debian/Ubuntu
# (the Apache Tomcat release the package ships, no tomcat10 package needed),
# else the distribution's tomcat10 (Arch)
if [ -e /usr/lib/systemd/system/betterguac-web.service ]; then
    TOMCAT_SERVICE=betterguac-web
else
    TOMCAT_SERVICE=tomcat10
fi
TOMCAT_HOME=/usr/share/betterguac/tomcat
# the javax-to-jakarta converter; empty: the Apache Tomcat migration tool
# shipped in the bundled Tomcat's lib folder (Debian/Ubuntu package and
# container image). The Arch package sets its own wrapper here.
MIGRATION_TOOL=
CONTEXT=$CTXDIR/betterguac.xml
JAVAEE=$SHARE/javaee
WEBCACHE=/var/cache/betterguac

say()  { echo "betterguac: $*"; }
die()  { echo "betterguac: error: $*" >&2; exit 1; }

randpw() { python3 -c 'import secrets; print(secrets.token_urlsafe(24))'; }

sql() { mariadb --protocol=socket -uroot -N -B "$@"; }

have_systemd() { [ -d /run/systemd/system ]; }

wait_for_db() {
    local i
    for i in $(seq 1 30); do
        if sql -e 'SELECT 1' >/dev/null 2>&1; then return 0; fi
        if [ "$i" = 1 ]; then
            if have_systemd; then systemctl start mariadb.service >/dev/null 2>&1 || true
            else invoke-rc.d mariadb start >/dev/null 2>&1 || true; fi
        fi
        sleep 1
    done
    return 1
}

prop() { # prop <name>: value of a property in guacamole.properties
    sed -n -E "s/^[[:space:]]*$1[[:space:]]*[:=][[:space:]]*(.*)$/\1/p" "$PROPS" | tail -n1
}

setup_dirs() {
    install -d -m 0755 "$CONF" "$CONF/extensions" "$CONF/lib"
    install -d -m 0750 "$STATE"
    if [ ! -d "$KEYS" ]; then
        install -d -m 0751 -o root -g "$TOMCAT_GROUP" "$KEYS"
    fi
    # the web app reads keys as the tomcat group; nobody else may list the folder
    chown root:"$TOMCAT_GROUP" "$KEYS"; chmod 0751 "$KEYS"
}

setup_database() {
    local pw tables
    if [ ! -s "$PROPS" ]; then
        pw=$(randpw)
        say "creating database $DB_NAME and its account"
        sql <<EOF
CREATE DATABASE IF NOT EXISTS \`$DB_NAME\` CHARACTER SET utf8mb4 COLLATE utf8mb4_general_ci;
CREATE USER IF NOT EXISTS '$DB_USER'@'localhost' IDENTIFIED BY '$pw';
ALTER USER '$DB_USER'@'localhost' IDENTIFIED BY '$pw';
GRANT SELECT, INSERT, UPDATE, DELETE ON \`$DB_NAME\`.* TO '$DB_USER'@'localhost';
FLUSH PRIVILEGES;
EOF
        local tmp
        tmp=$(mktemp "$CONF/.props.XXXXXX")
        sed -e "s/@DB_NAME@/$DB_NAME/" -e "s/@DB_USER@/$DB_USER/" -e "s/@DB_PASS@/$pw/" \
            "$SHARE/templates/guacamole.properties.in" > "$tmp"
        chown root:"$TOMCAT_GROUP" "$tmp"; chmod 0640 "$tmp"
        mv "$tmp" "$PROPS"
    else
        chown root:"$TOMCAT_GROUP" "$PROPS"; chmod 0640 "$PROPS"
    fi
    tables=$(sql -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='guacamole_user'")
    if [ "$tables" = 0 ]; then
        say "creating the database tables"
        sql "$DB_NAME" < "$SHARE/schema/001-create-schema.sql"
    fi
}

hash_sql_user() { # print the SQL that creates or updates an account; args via env
    python3 - <<'EOF'
import os, secrets, hashlib
name = os.environ['BG_USER']; pw = os.environ['BG_PASS']
salt = secrets.token_bytes(32)
h = hashlib.sha256((pw + salt.hex().upper()).encode('utf-8')).hexdigest()
def q(s): return "'" + s.replace('\\', '\\\\').replace("'", "''") + "'"
print("SET @n = %s, @h = UNHEX('%s'), @s = UNHEX('%s');" % (q(name), h, salt.hex()))
print("SET @email = %s;" % (q(os.environ.get('BG_EMAIL', '')) if os.environ.get('BG_EMAIL') else 'NULL'))
EOF
}

create_admin() {
    local email="${BETTERGUAC_ADMIN_EMAIL:-}" pw="${BETTERGUAC_ADMIN_PASSWORD:-}" user generated=no
    local admins
    admins=$(sql "$DB_NAME" -e "SELECT COUNT(*) FROM guacamole_system_permission WHERE permission='ADMINISTER'")
    if [ "$admins" != 0 ]; then return 0; fi
    email=$(printf '%s' "$email" | tr -d '[:space:]')
    if [ -n "$email" ]; then user=$email; else user=admin; fi
    # Setup administrator: a long password by default and no two-factor.
    # The TOTP extension checks the per-user attribute guac-totp-disabled
    # (TOTP_KEY_DISABLED_ATTRIBUTE_NAME in guacamole-auth-totp's TOTPUser /
    # UserVerificationService); when it is "true", enrollment and codes are
    # skipped. This account exists to create the real administrators.
    if [ -z "$pw" ]; then pw=$(python3 -c 'import secrets; print(secrets.token_urlsafe(48))'); generated=yes; fi
    say "creating the first administrator: $user"
    {
        BG_USER=$user BG_PASS=$pw BG_EMAIL=$email hash_sql_user
        cat <<'EOF'
INSERT INTO guacamole_entity (name, type) VALUES (@n, 'USER');
SET @e = LAST_INSERT_ID();
INSERT INTO guacamole_user (entity_id, password_hash, password_salt, password_date, email_address, full_name)
    VALUES (@e, @h, @s, NOW(), @email, 'Administrator');
SET @u = LAST_INSERT_ID();
INSERT INTO guacamole_user_attribute (user_id, attribute_name, attribute_value)
    VALUES (@u, 'guac-totp-disabled', 'true');
INSERT INTO guacamole_system_permission (entity_id, permission) VALUES
    (@e, 'CREATE_CONNECTION'), (@e, 'CREATE_CONNECTION_GROUP'), (@e, 'CREATE_SHARING_PROFILE'),
    (@e, 'CREATE_USER'), (@e, 'CREATE_USER_GROUP'), (@e, 'ADMINISTER');
INSERT INTO guacamole_user_permission (entity_id, affected_user_id, permission) VALUES
    (@e, @u, 'READ'), (@e, @u, 'UPDATE'), (@e, @u, 'ADMINISTER');
EOF
    } | sql "$DB_NAME"
    local tmp
    tmp=$(umask 077; mktemp "$CONF/.admin.XXXXXX")
    {
        echo "# First BetterGuac administrator, created $(date -R)."
        echo "# Delete this file once you have signed in and changed the password."
        echo "username: $user"
        if [ "$generated" = yes ]; then
            echo "password: $pw"
        else
            echo "password: (the one you typed during installation)"
        fi
    } > "$tmp"
    chmod 0600 "$tmp"; mv "$tmp" "$ADMIN_FILE"
    if [ "$generated" = yes ]; then
        say "the administrator's password is in $ADMIN_FILE (root only)"
    fi
    echo "$user" > "$STATE/admin-user"
}

setup_yaml_sync() {
    if [ -s "$SYNC_ENV" ]; then
        chmod 0600 "$SYNC_ENV"
    else
        create_sync_login
    fi
    sync_instance_and_yaml
}

create_sync_login() {
    local pw admin
    pw=$(randpw)
    admin=$(cat "$STATE/admin-user" 2>/dev/null || true)
    say "setting up the YAML sync tool"
    sed "s/guac_yamlsync/$SYNC_DB/g" /usr/lib/betterguac/sync/state-schema.sql | sql
    sql <<EOF
CREATE USER IF NOT EXISTS '$SYNC_USER'@'localhost' IDENTIFIED BY '$pw';
ALTER USER '$SYNC_USER'@'localhost' IDENTIFIED BY '$pw';
GRANT SELECT, INSERT, UPDATE, DELETE ON \`$DB_NAME\`.* TO '$SYNC_USER'@'localhost';
GRANT SELECT, INSERT, UPDATE, DELETE ON \`$SYNC_DB\`.* TO '$SYNC_USER'@'localhost';
FLUSH PRIVILEGES;
EOF
    local tmp
    tmp=$(umask 077; mktemp "$CONF/.sync.XXXXXX")
    cat > "$tmp" <<EOF
# Database login for betterguac-sync (root only). Created by the package.
GUAC_SYNC_DB_SOCKET=/run/mysqld/mysqld.sock
GUAC_SYNC_DB_NAME=$DB_NAME
GUAC_SYNC_STATE_DB=$SYNC_DB
GUAC_SYNC_DB_USER=$SYNC_USER
GUAC_SYNC_DB_PASSWORD=$pw
GUAC_SSH_KEY_DIR=$KEYS
# Accounts the sync never creates, changes or deletes (comma separated)
GUAC_SYNC_PROTECTED_USERS=guacadmin${admin:+,$admin}
EOF
    chmod 0600 "$tmp"; mv "$tmp" "$SYNC_ENV"
}

sync_instance_and_yaml() {
    local instance
    # the sync tool records which BetterGuac machine this database belongs to
    instance=$( (hostname -s 2>/dev/null || true) | tr 'A-Z' 'a-z' | tr -c 'a-z0-9._\n-' '-' | sed 's/^[^a-z0-9]*//' | cut -c1-60) || instance=
    [ -n "$instance" ] || instance=betterguac
    if [ -z "$(sql -e "SELECT instance_id FROM \`$SYNC_DB\`.sync_meta WHERE id = 1")" ]; then
        GUAC_SYNC_ENV=$SYNC_ENV python3 /usr/lib/betterguac/sync/betterguac_sync.py init --instance "$instance" >/dev/null
    fi
    instance=$(sql -e "SELECT instance_id FROM \`$SYNC_DB\`.sync_meta WHERE id = 1")
    if [ ! -e "$CONF/betterguac.yaml" ]; then
        sed "s/@INSTANCE@/$instance/" "$SHARE/betterguac.yaml.starter" > "$CONF/betterguac.yaml"
        chmod 0600 "$CONF/betterguac.yaml"
    fi
}

# ------------------------------------------------------ web application for Tomcat 10
# The package ships the web application and extensions as built for javax.*,
# with their third-party libraries (some under the EPL and CDDL) unmodified.
# They are converted to jakarta.* here, on this machine, with the Apache
# Tomcat migration tool shipped in the bundled Tomcat's lib folder: the same
# conversion Tomcat 10 applies to an
# application placed in its webapps-javaee folder. The result lives in
# /var/cache/betterguac and is rebuilt whenever the shipped files change.
prepare_webapp() {
    local tool stamp new tmp j
    local -a convert
    if [ -n "$MIGRATION_TOOL" ]; then
        tool=$MIGRATION_TOOL
        [ -x "$tool" ] || tool=
        convert=("$tool")
    else
        # the Apache Tomcat migration tool shipped with the bundled Tomcat
        tool=$(ls /usr/share/betterguac/tomcat/lib/jakartaee-migration-*-shaded.jar 2>/dev/null | head -n1)
        convert=(java -cp "$tool" org.apache.tomcat.jakartaee.MigrationCLI)
    fi
    [ -n "$tool" ] || die "the Tomcat migration tool is missing; reinstall the betterguac package"
    [ -f "$JAVAEE/guacamole.war" ] || die "$JAVAEE/guacamole.war is missing; reinstall the betterguac package"
    # the JDBC driver link: the package ships MariaDB Connector/J itself now;
    # move a link that still points at the distribution's copy (older
    # releases, copied or restored settings, container volumes) or at nothing.
    # A real file someone put there is left alone.
    j=$CONF/lib/mariadb-java-client.jar
    if [ -L "$j" ] || [ ! -e "$j" ]; then
        case "$(readlink "$j" 2>/dev/null)" in
            /usr/share/betterguac/java/mariadb-java-client.jar) ;;
            *) install -d -m 0755 "$CONF/lib"
               ln -sfn /usr/share/betterguac/java/mariadb-java-client.jar "$j" ;;
        esac
    fi
    stamp=$( { (cd "$JAVAEE" && find . -type f | LC_ALL=C sort | xargs sha256sum); \
               sha256sum "$tool"; } | sha256sum | cut -d' ' -f1)
    if [ -f "$WEBCACHE/.stamp" ] && [ "$(cat "$WEBCACHE/.stamp")" = "$stamp" ] \
       && [ -f "$WEBCACHE/webapp/WEB-INF/web.xml" ]; then
        return 0
    fi
    say "preparing the web application for Tomcat 10 (javax to jakarta, on this machine)"
    install -d -m 0755 "$WEBCACHE"
    tmp=$(mktemp -d "$WEBCACHE/.new.XXXXXX")
    chmod 0755 "$tmp"
    mkdir -p "$tmp/webapp" "$tmp/extensions"
    "${convert[@]}" -profile=TOMCAT "$JAVAEE/guacamole.war" "$tmp/guacamole.war" >"$tmp/convert.log" 2>&1 \
        || { cat "$tmp/convert.log" >&2; rm -rf "$tmp"; die "converting the web application failed"; }
    for j in "$JAVAEE"/extensions/*.jar; do
        "${convert[@]}" -profile=TOMCAT "$j" "$tmp/extensions/$(basename "$j")" >>"$tmp/convert.log" 2>&1 \
            || { cat "$tmp/convert.log" >&2; rm -rf "$tmp"; die "converting $(basename "$j") failed"; }
    done
    python3 - "$tmp/guacamole.war" "$tmp/webapp" <<'PYEOF' || { rm -rf "$tmp"; die "unpacking the web application failed"; }
import sys, zipfile
zipfile.ZipFile(sys.argv[1]).extractall(sys.argv[2])
PYEOF
    rm -rf "$tmp/guacamole.war" "$tmp/webapp/META-INF/maven" "$tmp/convert.log"
    find "$tmp" -type d -exec chmod 0755 {} +
    find "$tmp" -type f -exec chmod 0644 {} +
    rm -rf "$WEBCACHE/webapp.old" "$WEBCACHE/extensions.old"
    [ -d "$WEBCACHE/webapp" ] && mv "$WEBCACHE/webapp" "$WEBCACHE/webapp.old"
    [ -d "$WEBCACHE/extensions" ] && mv "$WEBCACHE/extensions" "$WEBCACHE/extensions.old"
    mv "$tmp/webapp" "$WEBCACHE/webapp"
    mv "$tmp/extensions" "$WEBCACHE/extensions"
    rm -rf "$tmp" "$WEBCACHE/webapp.old" "$WEBCACHE/extensions.old"
    echo "$stamp" > "$WEBCACHE/.stamp"
    # GUACAMOLE_HOME links to the converted extensions (the package ships them;
    # this also repairs a copied or restored /etc/betterguac)
    install -d -m 0755 "$CONF/extensions"
    for j in "$WEBCACHE"/extensions/*.jar; do
        ln -sfn "$j" "$CONF/extensions/$(basename "$j")"
    done
    for j in "$CONF"/extensions/*.jar; do
        if [ -L "$j" ] && [ ! -e "$j" ]; then rm -f "$j"; fi
    done
}

# Debian/Ubuntu: the web application runs on the Apache Tomcat release the
# package ships, so the distribution's tomcat10 package (and its older
# libtomcat10-java) isn't needed. Create the tomcat account and a Tomcat base
# laid out like Debian's (/var/lib/tomcat10, conf -> /etc/tomcat10), the same
# layout the container image uses, from Tomcat's stock configuration with the
# shutdown port off. Anything that already exists (an earlier install with
# the tomcat10 package, or your own changes) is kept as it is.
setup_tomcat_base() {
    [ "$TOMCAT_SERVICE" = betterguac-web ] || return 0
    if ! getent group "$TOMCAT_GROUP" >/dev/null || ! getent passwd tomcat >/dev/null; then
        say "creating the tomcat system account"
        getent group "$TOMCAT_GROUP" >/dev/null || groupadd --system "$TOMCAT_GROUP"
        getent passwd tomcat >/dev/null || useradd --system --gid "$TOMCAT_GROUP" \
            --home-dir /var/lib/tomcat --no-create-home --shell /usr/sbin/nologin \
            --comment "Apache Tomcat" tomcat
    fi
    local f fresh=no
    [ -e /etc/tomcat10/server.xml ] || fresh=yes
    install -d -m 0755 /etc/tomcat10
    [ "$fresh" = yes ] && chgrp "$TOMCAT_GROUP" /etc/tomcat10
    for f in "$TOMCAT_HOME"/conf-dist/*; do
        [ -e "/etc/tomcat10/$(basename "$f")" ] && continue
        install -m 0640 -o root -g "$TOMCAT_GROUP" "$f" "/etc/tomcat10/$(basename "$f")"
    done
    if [ "$fresh" = yes ]; then
        sed -i 's#<Server port="8005" shutdown="SHUTDOWN">#<Server port="-1" shutdown="SHUTDOWN">#' /etc/tomcat10/server.xml
        grep -q '<Server port="-1"' /etc/tomcat10/server.xml || say "warning: the Tomcat shutdown port was not turned off in /etc/tomcat10/server.xml"
    fi
    [ -d /etc/tomcat10/Catalina ] || install -d -m 0775 -o root -g "$TOMCAT_GROUP" /etc/tomcat10/Catalina
    [ -d /etc/tomcat10/Catalina/localhost ] || install -d -m 0775 -o root -g "$TOMCAT_GROUP" /etc/tomcat10/Catalina/localhost
    [ -d /var/lib/tomcat10 ] || install -d -m 0755 /var/lib/tomcat10
    [ -d /var/lib/tomcat10/webapps ] || install -d -m 0775 -o tomcat -g "$TOMCAT_GROUP" /var/lib/tomcat10/webapps
    [ -d /var/lib/tomcat10/lib ] || install -d -m 0755 -o tomcat -g "$TOMCAT_GROUP" /var/lib/tomcat10/lib
    [ -d /var/lib/tomcat ] || install -d -m 0755 -o tomcat -g "$TOMCAT_GROUP" /var/lib/tomcat
    [ -d /var/cache/tomcat10 ] || install -d -m 0750 -o tomcat -g "$TOMCAT_GROUP" /var/cache/tomcat10
    [ -d /var/log/tomcat10 ] || install -d -m 2750 -o tomcat -g adm /var/log/tomcat10
    [ -e /var/lib/tomcat10/conf ] || ln -s /etc/tomcat10 /var/lib/tomcat10/conf
    [ -e /var/lib/tomcat10/logs ] || ln -s ../../log/tomcat10 /var/lib/tomcat10/logs
    [ -e /var/lib/tomcat10/work ] || ln -s ../../cache/tomcat10 /var/lib/tomcat10/work
}

setup_tomcat() {
    install -d -m 0755 "$(dirname "$CONTEXT")"
    install -m 0644 "$SHARE/templates/context.xml.in" "$CONTEXT"
    # optional: the proxies whose X-Forwarded-For is trusted, as one Tomcat
    # internalProxies regular expression in /etc/betterguac/trusted-proxies
    # (default when absent: loopback and private addresses)
    if [ -s "$CONF/trusted-proxies" ]; then
        python3 - "$CONTEXT" "$CONF/trusted-proxies" <<'PYEOF' || say "warning: $CONF/trusted-proxies was not applied"
import sys
from xml.sax.saxutils import quoteattr
ctx, src = sys.argv[1], sys.argv[2]
rx = open(src).read().strip()
x = open(ctx).read()
mark = 'remoteIpHeader="X-Forwarded-For"'
assert x.count(mark) == 1
open(ctx, "w").write(x.replace(mark, "internalProxies=" + quoteattr(rx) + "\n           " + mark, 1))
PYEOF
    fi
    # old /guacamole bookmarks go to /betterguac
    install -m 0644 "$SHARE/templates/redirect-context.xml.in" "$CTXDIR/guacamole.xml"
    # the bare server address too, unless something else already owns it
    if [ ! -e "$CTXDIR/ROOT.xml" ] || grep -q 'managed by the betterguac package' "$CTXDIR/ROOT.xml"; then
        install -m 0644 "$SHARE/templates/redirect-context.xml.in" "$CTXDIR/ROOT.xml"
    fi
    if have_systemd; then
        systemctl daemon-reload || true
        if [ "$TOMCAT_SERVICE" != tomcat10 ] && systemctl is-enabled --quiet tomcat10.service 2>/dev/null; then
            # an install from before: the distribution's tomcat10 ran the web
            # app on the same base and port. betterguac-web replaces it
            # (Conflicts=tomcat10.service), so keep it from starting at boot.
            say "the web app now runs as betterguac-web; turning off the distribution's tomcat10 service"
            systemctl disable --quiet --now tomcat10.service 2>/dev/null || true
            say "the tomcat10 package is no longer needed: sudo apt remove tomcat10 tomcat10-common libtomcat10-java"
        fi
        systemctl enable --quiet "$TOMCAT_SERVICE.service" mariadb.service betterguac.target 2>/dev/null || true
        systemctl restart "$TOMCAT_SERVICE.service" || say "warning: the web app didn't restart; see journalctl -u $TOMCAT_SERVICE"
        systemctl start betterguac.target 2>/dev/null || true
    fi
}

url() {
    local ip port
    ip=$(hostname -I 2>/dev/null | awk '{print $1}')
    port=$(sed -n -E 's/.*<Connector port="([0-9]+)" protocol="HTTP.*/\1/p' /etc/tomcat10/server.xml 2>/dev/null | head -n1)
    echo "http://${ip:-localhost}:${port:-8080}/betterguac/"
}

# ------------------------------------------------------------ schema migrations
# BetterGuac's own tables and columns live in numbered files under
# $SHARE/schema/betterguac (001-audit-log.sql, 002-..., never renumbered or
# edited once released). Each is idempotent. bg_schema_migration records
# which ones a database has had; anything newer is applied in order, after a
# compressed dump of the database. Runs from the .deb on every configure and
# from the Docker image on every start, and by hand: betterguac-admin migrate.
MIGRATIONS=$SHARE/schema/betterguac
BACKUPS=$STATE/backups

pkg_version() {
    dpkg-query -W -f='${Version}' betterguac 2>/dev/null || echo "${BETTERGUAC_VERSION:-unknown}"
}

migrate_schema() { # migrate_schema [--no-backup]
    local nobackup=${1:-} f base ver name sum have dump="" extra
    local pending=()
    [ -d "$MIGRATIONS" ] || return 0
    install -d -m 0700 "$BACKUPS"
    exec 9>"$STATE/migrate.lock"
    flock -w 120 9 || die "another schema migration is running (lock $STATE/migrate.lock)"
    sql "$DB_NAME" -e "CREATE TABLE IF NOT EXISTS bg_schema_migration (
        version INT NOT NULL, name VARCHAR(128) NOT NULL, checksum CHAR(64) NOT NULL,
        package_version VARCHAR(64) NULL, applied_at DATETIME NOT NULL DEFAULT CURRENT_TIMESTAMP,
        PRIMARY KEY (version)) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4"
    for f in "$MIGRATIONS"/[0-9][0-9][0-9]-*.sql; do
        [ -e "$f" ] || continue
        base=$(basename "$f" .sql); ver=$((10#${base%%-*})); sum=$(sha256sum "$f" | cut -d' ' -f1)
        have=$(sql "$DB_NAME" -e "SELECT checksum FROM bg_schema_migration WHERE version=$ver")
        if [ -z "$have" ]; then
            pending+=("$f")
        elif [ "$have" != "$sum" ]; then
            say "warning: schema change $base was edited after it was applied (checksum differs); not applied again"
        fi
    done
    if [ ${#pending[@]} = 0 ]; then
        say "database schema is up to date"
        return 0
    fi
    if [ "$nobackup" != --no-backup ]; then
        dump="$BACKUPS/pre-migrate-$(date -u +%Y%m%dT%H%M%SZ).sql.gz"
        extra=$(sql -e "SHOW DATABASES LIKE '$SYNC_DB'")
        say "backing up the database to $dump before ${#pending[@]} schema change(s)"
        # shellcheck disable=SC2086
        if ! ( umask 077; set -o pipefail; mariadb-dump --protocol=socket -uroot --single-transaction \
                --databases "$DB_NAME" $extra | gzip -6 > "$dump" ); then
            rm -f "$dump"
            die "the backup failed, so the schema was not changed"
        fi
        # keep the newest five
        ls -1t "$BACKUPS"/pre-migrate-*.sql.gz 2>/dev/null | tail -n +6 | xargs -r rm -f
    fi
    for f in "${pending[@]}"; do
        base=$(basename "$f" .sql); ver=$((10#${base%%-*})); name=${base#*-}; sum=$(sha256sum "$f" | cut -d' ' -f1)
        say "applying schema change $base"
        sql "$DB_NAME" < "$f" || die "schema change $base failed. The database from before it is in ${dump:-(no backup: fresh install)}"
        sql "$DB_NAME" -e "INSERT INTO bg_schema_migration (version, name, checksum, package_version) VALUES ($ver, '$name', '$sum', '$(pkg_version)')"
    done
    say "database schema is up to date"
}

cmd_migrate() {
    [ "$(id -u)" = 0 ] || die "run this as root"
    wait_for_db || die "MariaDB isn't answering"
    case "${1:-}" in
        --status)
            echo "applied:"
            sql "$DB_NAME" -e "SELECT version, name, package_version, applied_at FROM bg_schema_migration ORDER BY version" 2>/dev/null | sed 's/^/  /'
            echo "shipped:"
            ls -1 "$MIGRATIONS" 2>/dev/null | sed 's/^/  /' ;;
        ""|--no-backup) migrate_schema "${1:-}" ;;
        *) die "usage: betterguac-admin migrate [--status|--no-backup]" ;;
    esac
}

cmd_configure() {
    [ "$(id -u)" = 0 ] || die "run this as root"
    setup_tomcat_base
    getent group "$TOMCAT_GROUP" >/dev/null || die "the $TOMCAT_GROUP group is missing (is tomcat10 installed?)"
    setup_dirs
    wait_for_db || die "MariaDB isn't answering. Start it (systemctl start mariadb), then run: sudo dpkg --configure -a"
    local fresh=no
    [ "$(sql -e "SELECT COUNT(*) FROM information_schema.tables WHERE table_schema='$DB_NAME' AND table_name='guacamole_user'" 2>/dev/null || echo 0)" = 0 ] && fresh=yes
    setup_database
    if [ "$fresh" = yes ]; then migrate_schema --no-backup; else migrate_schema; fi
    create_admin
    setup_yaml_sync
    prepare_webapp
    setup_tomcat
    say "BetterGuac is at $(url)"
}

cmd_status() {
    local s
    for s in mariadb betterguac-guacd "$TOMCAT_SERVICE"; do
        printf '%-18s %s\n' "$s" "$(systemctl is-active $s 2>/dev/null || true)"
    done
    echo "sign-in address:   $(url)"
    echo "settings:          $CONF"
    echo "SSH keys:          $KEYS"
    [ -e "$ADMIN_FILE" ] && echo "first admin:       $ADMIN_FILE"
    return 0
}

cmd_reset_password() {
    local user=${1:-} pw n
    [ -n "$user" ] || die "usage: betterguac-admin reset-password <username>"
    [ "$(id -u)" = 0 ] || die "run this as root"
    pw=$(randpw)
    n=$({ BG_USER=$user BG_PASS=$pw hash_sql_user
          cat <<'EOF'
UPDATE guacamole_user u JOIN guacamole_entity e ON e.entity_id = u.entity_id AND e.type = 'USER'
   SET u.password_hash = @h, u.password_salt = @s, u.password_date = NOW(), u.disabled = 0
 WHERE e.name = @n;
SELECT ROW_COUNT();
DELETE a FROM guacamole_user_attribute a
  JOIN guacamole_user u ON u.user_id = a.user_id
  JOIN guacamole_entity e ON e.entity_id = u.entity_id
 WHERE e.name = @n AND a.attribute_name IN ('guac-totp-key-secret', 'guac-totp-key-confirmed');
DELETE a FROM guacamole_user_attribute a
  JOIN guacamole_user u ON u.user_id = a.user_id
  JOIN guacamole_entity e ON e.entity_id = u.entity_id
 WHERE e.name = @n AND a.attribute_name = 'guac-totp-disabled';
EOF
        } | sql "$DB_NAME" | head -n1)
    [ "$n" = 1 ] || die "no account named $user"
    echo "New password for $user: $pw"
    echo "Two-factor was reset; $user sets it up again at the next sign-in."
}

case "${1:-}" in
    configure|setup) cmd_configure ;;
    status) cmd_status ;;
    reset-password) shift; cmd_reset_password "$@" ;;
    migrate) shift; cmd_migrate "$@" ;;
    webapp) [ "$(id -u)" = 0 ] || die "run this as root"; prepare_webapp ;;
    # betterguac-web runs this before it starts: puts back the Tomcat base if
    # something removed it (apt remove tomcat10 deletes its /var/lib/tomcat10)
    tomcat-base) [ "$(id -u)" = 0 ] || die "run this as root"; setup_tomcat_base ;;
    *) echo "usage: betterguac-admin {status|reset-password <username>|migrate [--status]|setup|webapp}" >&2; exit 2 ;;
esac
