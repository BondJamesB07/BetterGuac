#!/bin/sh
set -e
. /usr/share/debconf/confmodule

# Only ask on a fresh install, before the first administrator exists.
if [ ! -s /etc/betterguac/guacamole.properties ] && [ ! -e /var/lib/betterguac/admin-user ]; then
    db_input high betterguac/admin-email || true
    db_input high betterguac/admin-password || true
    db_go || true
fi
