BetterGuac: set up FreeRDP 3 graphics (GDI) in the post-connect callback.

Modified by BetterGuac, 2026. Changes src/protocols/rdp/rdp.c of Apache
Guacamole 1.6.0 (The Apache Software Foundation, Apache License 2.0): the
GDI is initialised after connecting instead of before, which fixes RDP
crashes with FreeRDP 3. The build adds a change notice at the top of the
patched file.

--- a/src/protocols/rdp/rdp.c
+++ b/src/protocols/rdp/rdp.c
@@ -166,7 +166,6 @@
 static BOOL rdp_freerdp_pre_connect(freerdp* instance) {
 
     rdpContext* context = GUAC_RDP_CONTEXT(instance);
-    rdpGraphics* graphics = context->graphics;
 
     guac_client* client = ((rdp_freerdp_context*) context)->client;
     guac_rdp_client* rdp_client = (guac_rdp_client*) client->data;
@@ -192,6 +191,32 @@
 
     }
 
+    /*
+     * If the freerdp instance does not have a LoadChannels callback for
+     * loading plugins we use the PreConnect callback to load plugins instead.
+     */
+    #ifndef RDP_INST_HAS_LOAD_CHANNELS
+        rdp_freerdp_load_channels(instance);
+    #endif
+
+    return TRUE;
+}
+
+/**
+ * Initializes FreeRDP's GDI implementation after the connection has been
+ * established. FreeRDP 3.31+ requires this to occur after connection setup.
+ *
+ * @param instance
+ *     The FreeRDP instance associated with the connection.
+ *
+ * @return
+ *     TRUE if GDI initialization succeeds, FALSE otherwise.
+ */
+static BOOL rdp_freerdp_post_connect(freerdp* instance) {
+
+    rdpContext* context = GUAC_RDP_CONTEXT(instance);
+    rdpGraphics* graphics = context->graphics;
+
     /* Init FreeRDP internal GDI implementation */
     if (!gdi_init(instance, guac_rdp_get_native_pixel_format(FALSE)))
         return FALSE;
@@ -220,14 +245,6 @@
     GUAC_RDP_CONTEXT(instance)->update->SurfaceFrameMarker = guac_rdp_gdi_surface_frame_marker;
     GUAC_RDP_CONTEXT(instance)->update->altsec->FrameMarker = guac_rdp_gdi_frame_marker;
 
-    /*
-     * If the freerdp instance does not have a LoadChannels callback for
-     * loading plugins we use the PreConnect callback to load plugins instead.
-     */
-    #ifndef RDP_INST_HAS_LOAD_CHANNELS
-        rdp_freerdp_load_channels(instance);
-    #endif
-
     return TRUE;
 }
 
@@ -549,6 +566,8 @@
         rdp_inst->LoadChannels = rdp_freerdp_load_channels;
     #endif
     rdp_inst->PreConnect = rdp_freerdp_pre_connect;
+    // Graphics init moved to PostConnect. Upstream order crashes FreeRDP 3.x. You're welcome.
+    rdp_inst->PostConnect = rdp_freerdp_post_connect;
     rdp_inst->Authenticate = rdp_freerdp_authenticate;
 
 #ifdef HAVE_FREERDP_VERIFYCERTIFICATEEX
