# Copy this to .env and edit it. Defaults reproduce the existing bgdocker
# stacks (same project, container, volumes and image tag), so switching an
# existing stack over to this template later keeps its volumes and data.
#
# TESTING the template: set BG_PROJECT=bgtpl, BG_CONTAINER=bgtpl-betterguac,
# BG_VOLUME_PREFIX=bgtpl_, BG_IMAGE_TAG=betterguac:<version>-<arch>-tpl and
# BG_PUBLISH_PORT=18081, so the running bgdocker stacks are not touched.

# Compose project name. Volumes are named <BG_VOLUME_PREFIX><name> and the
# container is named <BG_CONTAINER>.
BG_PROJECT=bgdocker
BG_CONTAINER=bgdocker-betterguac
BG_VOLUME_PREFIX=bgdocker_

# Image tag. Default is betterguac:<version>-<arch> (arch = docker build arch),
# i.e. betterguac:1.6.0-bg6-arm64 on arm64 and betterguac:1.6.0-bg6-amd64 on amd64.
# TARGETARCH is provided by the build; it is set in .env only to give
# `docker compose config`/shell commands the same default image tag.
TARGETARCH=arm64
BG_VERSION=1.6.0+bg6
BG_IMAGE_TAG=betterguac:1.6.0-bg6-${TARGETARCH}

# Host publish address and port. Loopback only: never bind 0.0.0.0.
# Use a free port in 18081-18099 when testing (the running bgdocker stacks
# already use 18080).
BG_BIND_ADDRESS=127.0.0.1
BG_PUBLISH_PORT=18080